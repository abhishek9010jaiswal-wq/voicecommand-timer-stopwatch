# =============================================
# Gemini API Keys — Round-Robin Pool
# =============================================
# OPTION A (Recommended): Multiple keys, comma-separated — automatic round-robin rotation
# Each request will use the next key in sequence. If one hits rate-limit (429), next key is tried.
GEMINI_API_KEYS="AIzaSy...key1,AIzaSy...key2,AIzaSy...key3"

# OPTION B (Legacy): Single key — still works, backward compatible
# GEMINI_API_KEY="AIzaSy...single_key"

GEMINI_MODEL="gemini-2.0-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
